{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowSageMakerAccess",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::891807086260:role/mlops-diabetes-sagemaker-execution-dev"
            },
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::mlops-diabetes-dev-891807086260",
                "arn:aws:s3:::mlops-diabetes-dev-891807086260/*"
            ]
        },
        {
            "Sid": "AllowGitHubActionsAccess",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::891807086260:role/GitHubActions-MLOps-Dev"
            },
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::mlops-diabetes-dev-891807086260",
                "arn:aws:s3:::mlops-diabetes-dev-891807086260/*"
            ]
        },
        {
            "Sid": "DenyUnencryptedObjectUploads",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::mlops-diabetes-dev-891807086260/*",
            "Condition": {
                "StringNotEquals": {
                    "s3:x-amz-server-side-encryption": "AES256"
                }
            }
        },
        {
            "Sid": "DenyInsecureTransport",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:*",
            "Resource": [
                "arn:aws:s3:::mlops-diabetes-dev-891807086260",
                "arn:aws:s3:::mlops-diabetes-dev-891807086260/*"
            ],
            "Condition": {
                "Bool": {
                    "aws:SecureTransport": "false"
                }
            }
        }
    ]
}
