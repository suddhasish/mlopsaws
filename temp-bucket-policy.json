{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowSageMakerExecutionRole",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::891807086260:role/service-role/AmazonSageMaker-ExecutionRole-20251026T145759"
            },
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": [
                "arn:aws:s3:::mlops-diabetes-dev-891807086260",
                "arn:aws:s3:::mlops-diabetes-dev-891807086260/*"
            ]
        },
        {
            "Sid": "AllowGitHubActionsAccess",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::891807086260:role/GitHubActions-MLOps-Dev"
            },
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": [
                "arn:aws:s3:::mlops-diabetes-dev-891807086260",
                "arn:aws:s3:::mlops-diabetes-dev-891807086260/*"
            ]
        },
        {
            "Sid": "DenyInsecureTransport",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:*",
            "Resource": [
                "arn:aws:s3:::mlops-diabetes-dev-891807086260",
                "arn:aws:s3:::mlops-diabetes-dev-891807086260/*"
            ],
            "Condition": {
                "Bool": {
                    "aws:SecureTransport": "false"
                }
            }
        }
    ]
}
